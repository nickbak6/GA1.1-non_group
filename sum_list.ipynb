   "outputs": [],
   "source": [
    "def add(a,b):\n",
    "    return a + b\n",
    "def sum_list(values):\n",
    "    total = 0\n",
    "    for val in values:\n",
    "        total = add(total, val)\n",
    "    return total"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "581088e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(sum_list([1, 2, 3, 4, 5])) \n",
    "print(sum_list([-2, 5, -3]))\n",
    "print(sum_list([10.5, 2.5, 3.0]))"
   ]
  }
