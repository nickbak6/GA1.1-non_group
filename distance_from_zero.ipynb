   "source": [
    "def subtract(a, b):\n",
    "    return a - b\n",
    "\n",
    "def distance_from_zero(x):\n",
    "    if x < 0:\n",
    "        return subtract(0, x)\n",
    "    return subtract(x, 0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3dc0e52f",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(distance_from_zero(5))\n",
    "print(distance_from_zero(-8))\n",
    "print(distance_from_zero(-3.5))"
   ]
  }
